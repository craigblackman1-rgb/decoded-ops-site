[0m$ [0mfunction Get-WebpSize($path) {
  $bytes = [System.IO.File]::ReadAllBytes($path)
  # VP8X extended header
  if ($bytes[12] -eq 0x2F) {
    $w = 1 + ($bytes[24] -bor ($bytes[25] -shl 8) -bor ($bytes[26] -shl 16))
    $h = 1 + ($bytes[27] -bor ($bytes[28] -shl 8) -bor ($bytes[29] -shl 16))
    return "$w`x$h"
  }
  # VP8 (lossy)
  if ($bytes[12] -eq 0x20 -and $bytes[15] -eq 0x9D) {
    $w = (($bytes[26] -band 0xF0) -shl 4) + $bytes[27]
    $h = (($bytes[28] -band 0xF0) -shl 4) + $bytes[29]
    return "$w`x$h"
  }
  # VP8L (lossless)
  if ($bytes[12] -eq 0x4F) {
    $b0=$bytes[21]; $b1=$bytes[22]; $b2=$bytes[23]; $b3=$bytes[24]
    $w = 1 + (($b0 -bor (($b1 -band 0x3F) -shl 8)))
    $h = 1 + ((($b1 -band 0xC0) -shr 6) -bor ($b2 -shl 2) -bor (($b3 -band 0x0F) -shl 10))
    return "$w`x$h"
  }
  return "unknown"
}
