const fs = require('fs');
// Replace the inline template-literal figure blocks in home pages with imports from lib/d17-figures.
function swap(file, importLine, afterImports, startMarker, endMarker, usage) {
  let src = fs.readFileSync(file, 'utf8');
  const s = src.indexOf(startMarker);
  const e = src.indexOf(endMarker, s) + endMarker.length;
  if (s < 0 || e < endMarker.length) throw new Error('markers not found in ' + file);
  src = src.slice(0, s) + usage + src.slice(e);
  if (!src.includes(afterImports)) throw new Error('anchor missing in ' + file);
  src = src.replace(afterImports, afterImports + '\n' + importLine);
  fs.writeFileSync(file, src, 'utf8');
  console.log('updated', file);
}
