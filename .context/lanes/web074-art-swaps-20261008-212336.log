[0m$ [0mfunction Get-WebpSize($path) {
  $b = [System.IO.File]::ReadAllBytes($path)
  $chunk = [System.Text.Encoding]::ASCII.GetString($b, 12, 4)
  if ($chunk -eq 'VP8 ') {
    $w = $b[26] -bor (($b[27] -band 0x3F) -shl 8)
    $h = $b[28] -bor (($b[29] -band 0x3F) -shl 8)
    return "$w`x$h"
  }
  if ($chunk -eq 'VP8L') {
    $b0=$b[21]; $b1=$b[22]; $b2=$b[23]; $b3=$b[24]
    $w = 1 + ($b0 -bor (($b1 -band 0x3F) -shl 8))
    $h = 1 + ((($b1 -band 0xC0) -shr 6) -bor ($b2 -shl 2) -bor (($b3 -band 0x0F) -shl 10))
    return "$w`x$h"
  }
  if ($chunk -eq 'VP8X') {
    $w = 1 + ($b[24] -bor ($b[25] -shl 8) -bor ($b[26] -shl 16))
    $h = 1 + ($b[27] -bor ($b[28] -shl 8) -bor ($b[29] -shl 16))
    return "$w`x$h"
  }
  return "unknown($chunk)"
}
