          <h1 className="text-4xl lg:text-5xl font-bold text-[#023047] leading-tight mb-6">
            ERP Selection Playbook for Decorated Goods
          </h1>
          <p className="text-lg text-[#023047]/70 leading-relaxed mb-6">
