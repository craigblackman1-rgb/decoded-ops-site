    results[t] += (content.split(p1).length - 1);
    results[t] += (content.split(p2).length - 1);
    results[t] += (content.split(p3).length - 1);
  }
}

console.log('URL | Links');
console.log('--- | ---');
for (const t of targets) {
  const s = results[t] >= 3 ? 'OK' : 'LOW';
  console.log(t + ' | ' + results[t] + ' ' + s);
}
