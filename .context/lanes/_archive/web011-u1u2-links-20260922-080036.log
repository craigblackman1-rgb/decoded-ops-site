const { readFileSync, readdirSync, statSync } = require('fs');
const { join, extname } = require('path');

const targets = [
  '/problems/spreadsheet-addiction', '/problems/wrong-erp-software', '/problems/inventory-blind',
  '/problems/ecommerce-not-connected', '/problems/ops-in-owners-head', '/problems/legacy-system',
  '/problems/buy-vs-build', '/problems/no-ops-owner', '/problems/seasonal-peaks',
  '/problems/disaster-recovery', '/problems/erp-implementation-failure',
  '/sectors/labels-packaging', '/sectors/signs-graphics', '/sectors/awards-engraving',
  '/sectors/garment-decoration', '/sectors/print-promotional', '/sectors/workwear',
  '/sectors/teamwear-clubwear',
  '/resources/decoded-method', '/resources/sop-template', '/resources/erp-selection-playbook',
  '/resources/artwork-approval-playbook',
  '/tools/rto-calculator', '/tools/ops-health-score',
  '/case-studies/case-study-01', '/case-studies/case-study-03', '/case-studies/eternal-fitness',
];

function walk(dir) {
  let files = [];
  for (const d of readdirSync(dir)) {
    const p = join(dir, d);
    if (statSync(p).isDirectory()) files = files.concat(walk(p));
    else if (extname(p) === '.tsx' || extname(p) === '.ts') files.push(p);
  }
  return files;
}

const appFiles = walk('app').filter(f => !f.includes('Header.tsx') && !f.includes('Footer.tsx'));
const dataFiles = walk('data');
const allFiles = [...appFiles, ...dataFiles];

const results = {};
for (const t of targets) results[t] = 0;

for (const f of allFiles) {
  const content = readFileSync(f, 'utf8');
  for (const t of targets) {
    const pattern = 'href=\"' + t + '\"';
    const count = content.split(pattern).length - 1;
    results[t] += count;
  }
}

console.log('URL | Inbound Links');
console.log('--- | ---');
for (const t of targets) {
  console.log(t + ' | ' + results[t]);
}
