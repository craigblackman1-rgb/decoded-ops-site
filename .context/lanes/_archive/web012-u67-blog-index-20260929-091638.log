The `"` in the mojibake is U+201D (curly quote), not U+0022. Let me fix the patterns:
The issue is the third character ΓÇö U+201D, not U+2014. Let me just fix the 3 mojibake instances directly and add featuredImage:
[0m$ [0mnode -e "
const fs=require('fs');
const json=JSON.parse(fs.readFileSync('data/blog-index.json','utf8'));
let mojibakeCount=0;
for(const item of json.items){
  for(const key of ['title','excerpt']){
    if(typeof item[key]==='string'){
      const orig=item[key];
      // Fix ├óΓé¼\u201d (U+00E2 U+20AC U+201D) ΓåÆ ΓÇö (em dash)
      item[key]=item[key].replace(/\u00e2\u20ac\u201d/g,'\u2014');
      // Fix other common mojibake patterns
      item[key]=item[key].replace(/\u00e2\u20ac\u201c/g,'\u2013'); // en dash
      item[key]=item[key].replace(/\u00e2\u20ac\u2018/g,'\u2018'); // left single quote
      item[key]=item[key].replace(/\u00e2\u20ac\u2019/g,'\u2019'); // right single quote
      item[key]=item[key].replace(/\u00e2\u20ac\u00a6/g,'\u2026'); // ellipsis
      item[key]=item[key].replace(/\u00c2\u00a3/g,'\u00a3');       // pound sign
      item[key]=item[key].replace(/\u00c2\u00a0/g,' ');             // nbsp
      if(item[key]!==orig){console.log('Fixed '+item.slug+'.'+key);mojibakeCount++;}
    }
  }
}
fs.writeFileSync('data/blog-index.json',JSON.stringify(json,null,2)+'\n');
console.log('Mojibake fixes: '+mojibakeCount);
// Verify
const c=fs.readFileSync('data/blog-index.json','utf8');
const m=c.match(/\u00e2|\u00c2/g);
console.log('Remaining suspect chars: '+(m?m.length:0));
"
