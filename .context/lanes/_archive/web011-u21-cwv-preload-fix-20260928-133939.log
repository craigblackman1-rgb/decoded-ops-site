const sharp = require('sharp');
const path = require('path');

async function generateVariants() {
  const images = [
    { name: 'hero-workshop', src: 'public/images/d17/hero-workshop.webp', sizes: [800, 1200] },
    { name: 'thread-spools', src: 'public/images/d17/thread-spools.webp', sizes: [800, 1200] },
  ];

  for (const img of images) {
    for (const w of img.sizes) {
      const outPath = img.src.replace('.webp', '-' + w + '.webp');
      await sharp(img.src)
        .resize({ width: w, withoutEnlargement: true })
        .webp({ quality: 80 })
        .toFile(outPath);
      const meta = await sharp(outPath).metadata();
      console.log('Created: ' + outPath + ' (' + meta.width + 'x' + meta.height + ')');
    }
  }
}

generateVariants().catch(console.error);
