+
+/* ΓöÇΓöÇ Blog landing ΓÇö lead post ΓöÇΓöÇ */
+.blog-lead {
+  display: grid;
+  grid-template-columns: 1.15fr 1fr;
+  align-items: stretch;
+  background: var(--do-surface-raised);
+  border: 1px solid var(--do-border-subtle);
+  border-radius: var(--do-radius-2xl);
+  overflow: hidden;
+  text-decoration: none;
+  color: inherit;
+  transition: border-color var(--do-duration-normal) var(--do-ease-default),
+             box-shadow var(--do-duration-normal) var(--do-ease-default);
+}
+.blog-lead:hover { border-color: var(--do-cerulean); box-shadow: var(--do-shadow-md); }
+.blog-lead:focus-visible { outline: 3px solid var(--do-cerulean); outline-offset: 3px; }
+.blog-lead .lead-art {
+  width: 100%;
+  height: 100%;
+  display: block;
+  aspect-ratio: 16/9;
+  object-fit: cover;
+}
+.blog-lead .lead-body {
+  padding: 40px 44px;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+}
+@media (max-width: 900px) {
+  .blog-lead { grid-template-columns: 1fr; }
+  .blog-lead .lead-body { padding: 28px 26px; }
+}
+
+/* ΓöÇΓöÇ Blog landing ΓÇö filter rail ΓöÇΓöÇ */
+.blog-filter-pill {
+  font-family: var(--do-font-body);
+  font-size: var(--do-text-sm);
+  font-weight: 600;
+  padding: 8px 16px;
+  border-radius: 9999px;
+  cursor: pointer;
+  min-height: 38px;
+  background: transparent;
+  color: var(--do-text-secondary);
+  border: 1px solid var(--do-border-subtle);
+  transition: background-color var(--do-duration-fast) var(--do-ease-default),
+             border-color var(--do-duration-fast) var(--do-ease-default);
+}
+.blog-filter-pill:hover {
+  background: color-mix(in srgb, var(--do-cerulean) 10%, transparent);
+  border-color: var(--do-cerulean);
+  color: var(--do-text-primary);
+}
+.blog-filter-pill:focus-visible {
+  outline: 3px solid var(--do-cerulean);
+  outline-offset: 2px;
+}
+.blog-filter-pill[aria-pressed="true"] {
+  background: var(--do-prussian-blue);
+  color: var(--do-off-white);
+  border-color: var(--do-prussian-blue);
+}


