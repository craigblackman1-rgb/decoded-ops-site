$ node -e "
const fs = require('fs');
const path = require('path');
const glob = require('glob') || null;

// The 6 token mappings (case-insensitive)
const TOKEN_MAP = {
  '023047': 'prussian-blue',
  '219ebc': 'cerulean',
  '8ecae6': 'sky-blue',
  'ffb703': 'amber',
  'fb8500': 'orange-brand',
  'f8f9fa': 'off-white',
};

// Match: (variant prefix)*(tailwind prefix)-[#hex](/opacity)?
const RE = /((?:hover:|focus:|group-hover:|md:|lg:|sm:|xl:|2xl:|active:|disabled:)*(?:bg|text|border|ring|from|to|via|fill|stroke|decoration|divide|outline|shadow))-\[#([0-9A-Fa-f]{3,8})\](\/\d+)?/g;

function findTsxFiles(dir) {
  const results = [];
  const entries = fs.readdirSync(dir, { withFileTypes: true });
  for (const entry of entries) {
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      results.push(...findTsxFiles(full));
    } else if (/\.(tsx|ts)$/.test(entry.name)) {
      results.push(full);
    }
  }
  return results;
}

const componentsDir = path.join(__dirname, 'components');
const files = findTsxFiles(componentsDir);
let totalReplacements = 0;
const changes = {};

for (const file of files) {
  const rel = path.relative(__dirname, file);
  let content = fs.readFileSync(file, 'utf8');
  let count = 0;

  const newContent = content.replace(RE, (match, prefix, hex, opacity) => {
    const hexLower = hex.toLowerCase();
    const token = TOKEN_MAP[hexLower];
    if (token) {
      count++;
      return prefix + '-' + token + (opacity || '');
    }
    return match; // leave non-matching hexes alone
  });

  if (count > 0) {
    fs.writeFileSync(file, newContent, 'utf8');
    changes[rel] = count;
    totalReplacements += count;
  }
}

console.log('Replacements:', totalReplacements);
console.log('Files changed:');
for (const [f, c] of Object.entries(changes)) {
  console.log('  ' + f + ': ' + c);
}
"

