Now I understand the issue. The `fetchBlogPosts()` in the sitemap tries the hub API first. If the hub API returns a list that excludes the orderwise post (but the post is still accessible via the detail endpoint), the sitemap won't include it. The local blog-index.json has it, but it's only used as a fallback when the hub API fails entirely.

The fix: merge hub API results with the local blog-index.json so posts in the local file that are missing from the hub API index still appear in the sitemap.
ΓåÉ Edit app/sitemap.ts
Index: D:\apps\worktrees\decoded-ops-website\fix-redirects-sitemap\app\sitemap.ts
===================================================================
--- D:\apps\worktrees\decoded-ops-website\fix-redirects-sitemap\app\sitemap.ts
+++ D:\apps\worktrees\decoded-ops-website\fix-redirects-sitemap\app\sitemap.ts
@@ -7,22 +7,28 @@
 const BASE_URL = 'https://decodedops.co.uk'
 const HUB_API = process.env.HUB_API_URL || 'http://localhost:3000'
 
 async function fetchBlogPosts() {
+  let hubItems: any[] = [];
   try {
     const res = await hubFetch(`${HUB_API}/api/content/index`, {
       next: { revalidate: 300 },
     });
     if (res.ok) {
       const data = await res.json();
-      const hubItems = data.items || [];
-      // BUG-WEB-018: merge local fallback posts not present in hub index
-      // (hub may exclude drafts that are still live and indexed by Google)
-      const hubSlugs = new Set(hubItems.map((p: any) => p.slug));
-      const extraLocal = (localBlogPosts.items || []).filter((p: any) => !hubSlugs.has(p.slug));
-      return [...hubItems, ...extraLocal];
+      hubItems = data.items || [];
     }
   } catch {}
+
+  // Merge with local blog-index.json so posts present locally but missing
+  // from the hub API index (e.g. orderwise ΓÇö BUG-WEB-018) still appear.
+  const hubSlugs = new Set(hubItems.map((p: any) => p.slug));
+  const localOnly = (localBlogPosts.items || []).filter(
+    (p: any) => !hubSlugs.has(p.slug)
+  );
+  return [...hubItems, ...localOnly];
+}
+  } catch {}
   return localBlogPosts.items || [];
 }
 
 // Slugs are generated at BUILD time by scripts/generate-route-slugs.mjs (npm prebuild).


