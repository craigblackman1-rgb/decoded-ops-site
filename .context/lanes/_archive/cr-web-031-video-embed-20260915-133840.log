 }
+
+/* ── CR-WEB-031 · VideoEmbed block ── */
+.vid{ max-width:880px; margin:0 auto }
+.vid h2{ margin:14px 0 20px }
+.vid-frame{ position:relative; border-radius:16px; overflow:hidden; border:1px solid var(--do-border-subtle);
+  background:var(--do-off-white); box-shadow:0 8px 40px 0 rgba(255,183,3,0.2), 0 2px 8px 0 rgba(2,48,71,0.06) }
+.vid-chrome{ display:flex; align-items:center; gap:8px; padding:12px 16px; border-bottom:1px solid color-mix(in srgb, var(--do-sky-blue) 20%, transparent); background:var(--do-off-white) }
+.vid-dots{ display:flex; gap:6px } .vid-dots i{ width:12px; height:12px; border-radius:50%; display:block }
+.vid-dots i:nth-child(1){ background:var(--do-orange) } .vid-dots i:nth-child(2){ background:var(--do-amber) } .vid-dots i:nth-child(3){ background:var(--do-cerulean) }
+.vid-app{ flex:1; min-width:0; background:rgba(2,48,71,0.06); border-radius:6px; padding:6px 12px; font-size:12px; color:rgba(2,48,71,0.55); display:flex; align-items:center; gap:6px }
+.vid-len{ font-size:9px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--do-cerulean); border:1px solid color-mix(in srgb, var(--do-cerulean) 40%, transparent); border-radius:999px; padding:2px 8px }
+.vid-poster{ position:relative; aspect-ratio:16/9; display:grid; place-items:center; border:0; width:100%; padding:0; cursor:pointer; background:var(--do-off-white) }
+.vid-poster:focus-visible{ outline:3px solid var(--do-amber); outline-offset:-3px }
+.vid-poster-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover }
+.vid-play{ position:relative; width:64px; height:64px; border-radius:50%; background:var(--do-cerulean); display:grid; place-items:center; box-shadow:0 6px 24px rgba(0,0,0,.35); z-index:1 }
+.vid-play::after{ content:""; margin-left:5px; border-left:20px solid #fff; border-top:12px solid transparent; border-bottom:12px solid transparent }
+.vid-embed{ position:relative; aspect-ratio:16/9 }
+.vid-embed iframe{ position:absolute; inset:0; width:100%; height:100%; border:0 }
+.vid-close{ margin:18px 0 0; color:var(--do-text-muted); font-size:1.05rem }
+.vid-cta{ display:flex; flex-wrap:wrap; align-items:center; gap:14px 22px; margin:22px 0 0 }
+.vid-cta .yt{ color:var(--do-text-primary); text-decoration:underline; text-underline-offset:3px; font-weight:500 }
+.vid-pre{ margin:14px 0 0; font-size:.85rem; color:var(--do-text-muted) }
+@media (max-width:640px){ .vid-len{ display:none } .vid-cta .btn, .vid-cta .yt{ width:100%; text-align:center } }


