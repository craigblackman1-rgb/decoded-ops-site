I need to write a PowerShell script to systematically replace all Tailwind hex classes. The 14 files have hundreds of instances. Let me write and run the script.
$ pwsh -Command '
$files = @(
  "app/pricing/PricingClient.tsx",
  "app/page.tsx",
  "app/clarity/page.tsx",
  "app/retained/page.tsx",
  "app/privacy/page.tsx",
  "app/transform/page.tsx",
  "app/contact/ContactClient.tsx",
  "app/deliver/page.tsx",
  "app/decoded-data-app/page.tsx",
  "app/small-business/page.tsx",
  "app/cookies/page.tsx",
  "app/pricing/page.tsx",
  "app/layout.tsx",
  "app/blog/page.tsx"
)

$map = @{
  "023047" = "prussian-blue"
  "219EBC" = "cerulean"
  "8ECAE6" = "sky-blue"
  "FFB703" = "amber"
  "FB8500" = "orange-brand"
  "F8F9FA" = "off-white"
}

$totalReplacements = 0

foreach ($file in $files) {
  $content = Get-Content -Path $file -Raw
  $original = $content
  $fileCount = 0
  
  foreach ($hex in $map.Keys) {
    $token = $map[$hex]
    $before = $content
    # Match [#HEX] or [#HEX]/digits inside bracket notation
    # Lookbehind: [ prefix  Lookahead: ] or /digits
    $content = $content -replace "(?<=\[)#$hex(?=\](?:\/\d)?)", $token
    $diff = ([regex]::Matches($before, "(?<=\[)#$hex(?=\](?:\/\d)?)")).Count
    $fileCount += $diff
  }
  
  if ($content -ne $original) {
    Set-Content -Path $file -Value $content -NoNewline
  }
  
  if ($fileCount -gt 0) {
    Write-Output "$file : $fileCount replacements"
    $totalReplacements += $fileCount
  }
}

Write-Output "`nTotal replacements: $totalReplacements"
'
