[0m$ [0m$files = @(
  "D:\apps\worktrees\decoded-ops-website\web065-tech-seo\app\d17-global.css",
  "D:\apps\worktrees\decoded-ops-website\web065-tech-seo\app\d17-resources.css",
  "D:\apps\worktrees\decoded-ops-website\web065-tech-seo\app\d17-problems.css",
  "D:\apps\worktrees\decoded-ops-website\web065-tech-seo\app\d17-locations.css"
)

foreach ($file in $files) {
  $content = Get-Content $file -Raw
  $original = $content
  # Replace color:color-mix(in srgb, var(--do-prussian-blue) N%, transparent) where N < 72
  # Pattern: color: followed by color-mix with prussian-blue and a percentage < 72
  $content = $content -replace '(color:\s*color-mix\(in srgb, var\(--do-prussian-blue\)\s+)(\d+)(%, transparent\))', {
    param($match)
    $prefix = $match.Groups[1].Value
    $pct = [int]$match.Groups[2].Value
    $suffix = $match.Groups[3].Value
    if ($pct -lt 72) { "${prefix}72${suffix}" } else { $match.Value }
  }
  if ($content -ne $original) {
    Set-Content $file -Value $content -NoNewline
    Write-Host "Updated: $file"
  } else {
    Write-Host "No changes: $file"
  }
}
