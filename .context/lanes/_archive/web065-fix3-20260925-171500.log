)

foreach ($file in $files) {
  $lines = Get-Content $file
  $changed = 0
  for ($i = 0; $i -lt $lines.Count; $i++) {
    $line = $lines[$i]
    # Match color: followed by color-mix with prussian-blue
    if ($line -match 'color:\s*color-mix\(in srgb, var\(--do-prussian-blue\)\s+(\d+)%,\s*transparent\)') {
      $pct = [int]$Matches[1]
      if ($pct -lt 72) {
        $lines[$i] = $line -replace "(color:\s*color-mix\(in srgb, var\(--do-prussian-blue\)\s+)${pct}(%)" , "`${1}72`${2}"
        $changed++
      }
    }
  }
  if ($changed -gt 0) {
    Set-Content $file -Value ($lines -join "`n") -NoNewline
    Write-Host "$file : $changed lines changed"
  } else {
    Write-Host "$file : no changes"
  }
}
