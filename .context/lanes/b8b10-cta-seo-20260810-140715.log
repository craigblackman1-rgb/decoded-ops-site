+function deriveSlugs(subdir: string): string[] {
+  const dir = resolve(process.cwd(), 'app', subdir)
+  if (!existsSync(dir)) return []
+  return readdirSync(dir, { withFileTypes: true })
+    .filter(de => {
+      if (!de.isDirectory()) return false
+      if (de.name.startsWith('_') || de.name.startsWith('(') || de.name === '[...slug]' || de.name.startsWith('[...')) return false
+      return existsSync(resolve(dir, de.name, 'page.tsx'))
+    })
+    .map(de => de.name)
+}
+
